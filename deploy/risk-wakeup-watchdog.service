[Unit]
Description=Var/Lighter independent account risk wakeup watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Repository-name-variational-v1
EnvironmentFile=/home/ubuntu/Repository-name-variational-v1/.env
ExecStart=/home/ubuntu/Repository-name-variational-v1/.venv/bin/python tools/risk_wakeup_watchdog.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
