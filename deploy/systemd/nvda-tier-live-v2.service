[Unit]
Description=NVDA five-tier P50+1 entry / P80+1 exit trial (Entropy and RH)
After=network-online.target rh-entropy-depth-capture.service
Wants=network-online.target
ConditionPathExists=/home/ubuntu/repo/log/market_capture/high_frequency/health.json

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repo
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/repo/.venv/bin/python tools/nvda_tier_live.py --asset NVDA --pair entropy>lighter_rh --run-dir log/nvda_tier_live_v2 --seed-capture-dir log/market_capture/high_frequency --tiers 6.14,7.14,8.14,9.14,10.14 --exit-cost-bps 5.93 --profit-target-bps 1.0 --margin-usd 150 --rh-leverage 0 --verify-rh-leverage 20 --mode live --confirm-flat --i-understand-live-orders
Restart=no
NoNewPrivileges=true
TimeoutStopSec=30
