[Unit]
Description=Archive and truncate the live order metrics log
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Repository-name-variational-v1
ExecStart=/home/ubuntu/Repository-name-variational-v1/.venv/bin/python tools/rotate_order_metrics.py --min-size-mb 200 --keep 6
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true