[Unit]
Description=Shared Variational Chrome command bridge (8766-8768)
After=network-online.target var-chrome.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Repository-name-variational-v1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/Repository-name-variational-v1/.venv/bin/python -m variational.listener --quiet --no-monitor --output-dir /home/ubuntu/Repository-name-variational-v1/log/var_bridge
Restart=always
RestartSec=3
Nice=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target