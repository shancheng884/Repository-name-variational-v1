[Unit]
Description=Var/Lighter Beijing daily PnL Telegram report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Repository-name-variational-v1
EnvironmentFile=-/home/ubuntu/Repository-name-variational-v1/.env
ExecStart=/home/ubuntu/Repository-name-variational-v1/.venv/bin/python tools/daily_pnl_report.py --asset ETH

[Install]
WantedBy=multi-user.target
